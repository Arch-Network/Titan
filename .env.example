# GitHub Repository (for Docker image)
GITHUB_REPOSITORY=arch-network/titan

# Bitcoin Network Configuration
# One of: main, test, testnet4, signet, regtest (bitcoind chain names; Titan accepts them too).
BITCOIN_NETWORK=regtest
# bitcoind is started with -rpcport=$BITCOIN_RPC_PORT, so any port works on any network.
BITCOIN_RPC_PORT=18443
BITCOIN_RPC_USERNAME=bitcoin
# Required (compose refuses to start while empty). Use a long random value,
# e.g. `openssl rand -hex 32`.
BITCOIN_RPC_PASSWORD=

# Titan Configuration
TITAN_HTTP_PORT=3030
TITAN_TCP_PORT=8080
COMMIT_INTERVAL=5
INDEX_ADDRESSES=true
INDEX_BITCOIN_TRANSACTIONS=true
INDEX_SPENT_OUTPUTS=true
ENABLE_TCP_SUBSCRIPTIONS=true

# Webhook subscriptions. When enabled, WEBHOOK_ADMIN_TOKEN is required and every
# webhook subscription request must send `Authorization: Bearer <token>`.
ENABLE_WEBHOOK_SUBSCRIPTIONS=false
# WEBHOOK_ADMIN_TOKEN=change-me
# Webhooks to loopback/private/link-local addresses are rejected unless this is true.
WEBHOOK_ALLOW_PRIVATE_ENDPOINTS=false

# Docker Image Tag (examples: latest, v1.0.0, main, sha-abc123)
DOCKER_TAG=latest
# DOCKER_TAG=v1.0.0
# DOCKER_TAG=main
# DOCKER_TAG=sha-a1b2c3d
