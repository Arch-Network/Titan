{
  "name": "@titanbtcio/tests",
  "version": "0.0.8",
  "description": "Tests for Titan BTC indexer",
  "author": "Saturn BTC",
  "license": "MIT or Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "npm --prefix ../ts-sdk run build && tsc --noEmit"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "requirePragma": false,
    "insertPragma": false,
    "endOfLine": "lf"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@titanbtcio/sdk": "file:../ts-sdk",
    "@types/node": "^22.13.1",
    "bitcoinjs-lib": "^6.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "private": true
}
